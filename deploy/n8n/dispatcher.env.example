# Dispatcher receives NO R2/provider/WorkOS credentials.
DATABASE_URL=postgresql://restricted_worker:REPLACE@database.example.invalid/reink?sslmode=verify-full
WORKFLOW_WORKER_DATABASE_URL=postgresql://restricted_worker:REPLACE@database.example.invalid/reink?sslmode=verify-full
WORKFLOW_CUSTOMER_ORG_ID=org_REPLACE
WORKFLOW_WEBHOOK_URL=https://n8n.example.invalid/webhook/reink-extraction-v1
WORKFLOW_DISPATCH_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WORKFLOW_UPLOADS_ENABLED=false
WORKFLOW_QUEUE_TIMEOUT_SECONDS=600
WORKFLOW_PROCESSING_TIMEOUT_SECONDS=600
WORKFLOW_LEASE_SECONDS=60
WORKFLOW_HTTP_TIMEOUT_SECONDS=20
