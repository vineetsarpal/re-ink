# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/reink_db

# Application Settings
APP_NAME="re-ink"
DEBUG=True

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=./uploads

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO

# WorkOS Configuration
# Issuer + JWKS URL for access-token validation are derived from the client id.
# The API key is required for server-side WorkOS calls — currently minting the
# User Profile widget token (POST /api/widgets/user-profile/token). Without it
# that endpoint returns 500; access-token validation still works without it.
WORKOS_CLIENT_ID=your-workos-client-id
WORKOS_API_KEY=

# Workflow extraction (disabled until securely configured; no provider keys here)
WORKFLOW_UPLOADS_ENABLED=False
WORKFLOW_CUSTOMER_ORG_ID=
WORKFLOW_WEBHOOK_URL=
WORKFLOW_DISPATCH_TOKEN=
WORKFLOW_SERVICE_TOKEN=
WORKFLOW_WORKER_DATABASE_URL=
STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
